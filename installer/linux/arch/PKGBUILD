# Maintainer: The OpenDraft project <contact@openengineering.uk>
#
# Builds OpenDraft from a release tag. This is the file to submit to the AUR as
# `opendraft`; .github/workflows/packages.yml builds it in an Arch container with
# the sources replaced by the checked-out tree. (The third-party licence notices
# that the release archives carry are not generated here: a package built on the
# user's own machine redistributes nothing.) On a new release: set pkgver, run
# `updpkgsums`, and rebuild with `makepkg -s`.
pkgname=opendraft
pkgver=0.1.3
pkgrel=1
pkgdesc='Free, open-source 2D CAD with an AutoCAD-style command line'
arch=('x86_64')
url='https://github.com/JamesHodgkins/OpenDraft'
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'mesa'
  'wayland'
)
makedepends=('cargo')
optdepends=(
  'xdg-desktop-portal: file dialogs'
  'xdg-desktop-portal-gtk: file dialogs on GTK desktops'
  'xdg-desktop-portal-kde: file dialogs on KDE'
  'zenity: file dialogs when no desktop portal is running'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # run updpkgsums for a release

# The directory the source unpacks to (the CI build overrides it).
_srcdir="OpenDraft-$pkgver"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p od-app -p od-mcp
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/opendraft "$pkgdir/usr/bin/opendraft"
  install -Dm755 target/release/opendraft-mcp "$pkgdir/usr/bin/opendraft-mcp"

  install -Dm644 installer/linux/share/opendraft.desktop \
    "$pkgdir/usr/share/applications/opendraft.desktop"
  install -Dm644 installer/linux/opendraft.xml \
    "$pkgdir/usr/share/mime/packages/opendraft.xml"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "assets/app-icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/opendraft.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 readme.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/mcp.md "$pkgdir/usr/share/doc/$pkgname/MCP.md"
}
