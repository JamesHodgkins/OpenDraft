[Desktop Entry]
Type=Application
Name={{name}}
GenericName=2D CAD
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} {{exec_arg}}
Icon={{icon}}
Terminal=false
Categories=Graphics;2DGraphics;Engineering;
Keywords=CAD;drafting;drawing;DXF;DWG;
# The window's app id (see profile::app_id), so the desktop gives it this icon and groups it.
StartupWMClass=opendraft
# What the program opens. DXF and DWG are listed so file managers offer it in "Open with"; the
# desktop, not the package, decides which program is the default for them.
MimeType=application/x-opendraft-drawing;image/vnd.dxf;image/vnd.dwg;
